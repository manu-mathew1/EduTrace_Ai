# ===================================================
# EduTrace AI — Environment Variables Template
# Copy this file to .env and fill in your API keys
# NEVER COMMIT .env TO GIT!
# ===================================================

# --- Core Server Settings ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# For rapid local hackathon development, SQLite is supported out of the box:
DATABASE_URL=sqlite:///./edutrace.db
# For PostgreSQL: postgresql://user:password@localhost:5432/edutrace

# --- AI Models & Vision Providers ---
# Primary AI Provider (Gemini 1.5 Pro / Flash):
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional Fallbacks):
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- RAG & Vector Storage ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL=models/embedding-001

# --- Audio Generation (NotebookLM-Style 60s Micro-Audio) ---
# Optional: Uses ElevenLabs if provided, otherwise falls back to browser Web Speech API:
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Frontend Client ---
VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCK_DATA=true
